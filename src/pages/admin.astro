---
import Layout from '../layouts/Layout.astro';
import { listBookings, setStatus, storageReady } from '../lib/store';
import { services } from '../lib/clinic';
import { nowInClinic } from '../lib/slots';
import crypto from 'node:crypto';

export const prerender = false;

// Demo protection: set ADMIN_PASSWORD in production (default "demo" for the pitch).
const PASSWORD = process.env.ADMIN_PASSWORD || 'demo';
const token = crypto.createHash('sha256').update('bs-admin:' + PASSWORD).digest('hex');
let authed = Astro.cookies.get('bs_admin')?.value === token;
let loginError = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = fd.get('action');
  if (action === 'login') {
    if (fd.get('password') === PASSWORD) {
      Astro.cookies.set('bs_admin', token, { httpOnly: true, sameSite: 'strict', path: '/admin', maxAge: 60 * 60 * 8 });
      authed = true;
    } else loginError = 'Mot de passe incorrect.';
  } else if (action === 'logout') {
    Astro.cookies.delete('bs_admin', { path: '/admin' });
    authed = false;
  } else if (authed && storageReady() && (action === 'cancel' || action === 'restore')) {
    await setStatus(String(fd.get('id')), action === 'cancel' ? 'annulé' : 'confirmé');
  }
  if (authed) return Astro.redirect('/admin', 303);
}

const today = nowInClinic().date;
const view = Astro.url.searchParams.get('vue') === 'passes' ? 'passes' : 'avenir';
const ready = storageReady();
const all = authed && ready ? await listBookings() : [];
const list = all
  .filter((b) => (view === 'avenir' ? b.date >= today : b.date < today))
  .sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time) * (view === 'avenir' ? 1 : -1));
const byDay = new Map<string, typeof list>();
for (const b of list) byDay.set(b.date, [...(byDay.get(b.date) ?? []), b]);
const svc = (id: string) => services.find((s) => s.id === id)?.name ?? id;
const fmt = (d: string) => new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(d + 'T00:00:00Z'));
const todayCount = all.filter((b) => b.date === today && b.status === 'confirmé').length;
const upcoming = all.filter((b) => b.date >= today && b.status === 'confirmé').length;
---
<Layout title="Espace clinique, BeautifulSmile" description="Rendez-vous pris en ligne." bare>
  <section class="admin">
    <div class="wrap">
      {!authed ? (
        <form method="post" class="login">
          <h1>Espace clinique</h1>
          <p class="muted">Les rendez-vous pris en ligne, réservés à l’équipe.</p>
          <input type="hidden" name="action" value="login" />
          <label class="field"><span class="label">Mot de passe</span><input type="password" name="password" autocomplete="current-password" required autofocus /></label>
          {loginError && <p class="err" role="alert">{loginError}</p>}
          <button class="btn btn--primary" type="submit">Ouvrir l’agenda</button>
        </form>
      ) : (
        <>
          <div class="top">
            <h1>Agenda des rendez-vous</h1>
            <form method="post"><input type="hidden" name="action" value="logout" /><button class="btn btn--secondary" type="submit">Se déconnecter</button></form>
          </div>
          {!ready && <p class="notice" role="alert">Le stockage des rendez-vous n’est pas configuré sur ce serveur. Ajoutez Upstash Redis au projet Vercel (variables KV_REST_API_URL et KV_REST_API_TOKEN), puis redéployez.</p>}
          <div class="stats">
            <div><span class="label">Aujourd’hui</span><strong>{todayCount}</strong></div>
            <div><span class="label">À venir</span><strong>{upcoming}</strong></div>
            <div><span class="label">Total reçus en ligne</span><strong>{all.length}</strong></div>
          </div>
          <nav class="tabs">
            <a href="/admin" aria-current={view === 'avenir' ? 'page' : undefined}>À venir</a>
            <a href="/admin?vue=passes" aria-current={view === 'passes' ? 'page' : undefined}>Passés</a>
          </nav>
          {list.length === 0 && <p class="empty muted">Aucun rendez-vous {view === 'avenir' ? 'à venir' : 'passé'} pour le moment.</p>}
          {[...byDay].map(([day, items]) => (
            <div class="day">
              <h2>{fmt(day)}{day === today && <span class="pill">Aujourd’hui</span>}</h2>
              <table>
                <thead><tr><th>Heure</th><th>Patient</th><th>Téléphone</th><th>Soin</th><th>Message</th><th>Réf.</th><th></th></tr></thead>
                <tbody>
                  {items.map((b) => (
                    <tr class={b.status === 'annulé' ? 'is-cancelled' : ''}>
                      <td class="num">{b.time.replace(':', ' h ')}</td>
                      <td>{b.name}{b.email && <div class="muted small">{b.email}</div>}</td>
                      <td class="num"><a class="link" href={`https://wa.me/${b.phone.replace(/\D/g, '')}`} target="_blank" rel="noopener">{b.phone}</a></td>
                      <td>{svc(b.service)}</td>
                      <td class="note">{b.note || '—'}</td>
                      <td class="num small">{b.ref}</td>
                      <td>
                        <form method="post">
                          <input type="hidden" name="id" value={b.id} />
                          {b.status === 'confirmé'
                            ? <button class="mini" name="action" value="cancel">Annuler</button>
                            : <button class="mini" name="action" value="restore">Rétablir</button>}
                        </form>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </>
      )}
    </div>
  </section>
</Layout>

<style>
  .admin { padding: calc(var(--nav) + 64px) 0 96px; min-height: 100svh; }
  .login { max-width: 420px; display: grid; gap: 20px; }
  .login h1, .top h1 { font-size: 44px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field input { min-height: 48px; padding: 12px 14px; border: 1px solid rgb(16 41 42 / 0.25); border-radius: var(--r-sm); background: #fff; font-size: 16px; }
  .err { color: var(--danger); }
  .notice { margin-top: 24px; padding: 16px 20px; border-radius: var(--r-md); background: #fbeae8; color: var(--danger); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 40px 0; }
  .stats div { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 24px; display: grid; gap: 4px; }
  .stats strong { font-family: var(--f-display); font-weight: 400; font-size: 40px; line-height: 1; }
  .tabs { display: flex; gap: 24px; border-bottom: 1px solid var(--line); margin-bottom: 32px; }
  .tabs a { text-decoration: none; padding: 10px 0; color: var(--muted); font-weight: 500; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tabs a[aria-current='page'] { color: var(--ink); border-color: var(--accent); }
  .day { margin-bottom: 40px; }
  .day h2 { font-size: 24px; margin-bottom: 12px; display: flex; align-items: center; gap: 12px; }
  .day h2::first-letter { text-transform: uppercase; }
  .pill { font-family: var(--f-text); font-size: 13px; font-weight: 500; background: var(--accent-soft); color: var(--accent); padding: 4px 10px; border-radius: 999px; }
  table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; }
  th, td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 13px; font-weight: 500; color: var(--muted); background: var(--surface); }
  tr:last-child td { border-bottom: 0; }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .small { font-size: 14px; }
  .note { max-width: 28ch; color: var(--ink-2); }
  .is-cancelled td { color: var(--muted); text-decoration: line-through; }
  .is-cancelled td:last-child { text-decoration: none; }
  .mini { height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: transparent; cursor: pointer; font-size: 14px; }
  .mini:hover { border-color: var(--ink); }
  @media (max-width: 900px) {
    .stats { grid-template-columns: 1fr; }
    table, thead, tbody, tr, td { display: block; }
    thead { display: none; }
    tr { border-bottom: 1px solid var(--line); padding: 8px 0; }
    td { border: 0; padding: 4px 16px; }
  }
</style>
